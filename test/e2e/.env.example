# Copy to test/e2e/.env or repo-root .env (loaded automatically by TestMain for ./test/e2e).
# Recognized keys (aliases accepted): ONECLAW_E2E_BASE_URL or base_url / BASE_URL, same for api_key, default_model.

ONECLAW_E2E_BASE_URL=https://api.openai.com/v1
ONECLAW_E2E_API_KEY=
ONECLAW_E2E_DEFAULT_MODEL=gpt-4o-mini

# If ONECLAW_E2E_API_KEY is unset, Live tests fall back to OPENAI_API_KEY.

# Optional: force dotenv path
# ONECLAW_E2E_DOTENV=/absolute/path/.env

# Run real LLM for the whole e2e package (omit go test -short):
# ONECLAW_E2E_LIVE_LLM=1 go test ./test/e2e -count=1 -timeout 120m -v
